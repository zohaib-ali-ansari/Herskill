PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_change_in_production
FRONTEND_URL=http://localhost:5173

# Initial Admin Seeding (required to seed the first admin account)
ADMIN_EMAIL=admin@herskill.local
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=HerSkill Admin

# Private Document Storage Configuration
PRIVATE_DOCUMENT_STORAGE_PATH=./private_uploads
MAX_DOCUMENT_SIZE_MB=5

# Optional: Cloudinary (for future media features)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
